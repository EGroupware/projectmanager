<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="../../../doc/etemplate2/etemplate2.0.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
	<et2-template  id="projectmanager.elements.list.add" template="" lang="" group="0" version="1.9.001">
		<grid width="99%" height="99%">
			<columns>
				<column width="90%"/>
				<column width="9%"/>
			</columns>
			<rows>
				<row>
					<et2-link-to  label="Add existing" id="link_to" noFiles="true"></et2-link-to>
					<!--
					<et2-image  align="right" label="Show more options" src="extra_icons" onclick="app.projectmanager.toggleDiv" readonly="true"></et2-image>
					-->
				</row>
			</rows>
		</grid>
		<grid class="egwLinkMoreOptions">
			<columns>
				<column/>
			</columns>
			<rows>
				<row>
					<projectmanager-select-erole label="Element roles" id="eroles_add" no_lang="1" options="8,true,width:99%" span="all"/>
				</row>
			</rows>
		</grid>
	</et2-template>
	<et2-template  id="projectmanager.elements.list.rows" template="" lang="" group="0" version="1.9.005">
		<grid width="100%">
			<columns>
				<column width="10"/>
				<column width="100"/>
				<column width="90%"/>
			</columns>
			<rows>
				<row class="th">
				</row>
				<row class="$row_cont[class]">
					<et2-description  class="cat_$row_cont[cat_id] mobile_cat_col"></et2-description>
					<et2-vbox  align="left" class="elementCol1">
						<et2-hbox>
							<et2-image  label="$row_cont[pe_app]" src="${row}[pe_icon]"></et2-image>
							<et2-image  src="$row_cont[pe_completion_icon]" noLang="1"></et2-image>
							<et2-image  src="$row_cont[ignored]" noLang="1"></et2-image>
						</et2-hbox>
						<progress class="pe-completion" title="$row_cont[pe_completion]" value="$row_cont[pe_completion]" max="100"/>
						<et2-date-duration  label="Time" id="${row}[pe_used_time]" readonly="true" dataFormat="@@duration_format" ></et2-date-duration>
						<et2-date-duration  label="Planned" id="${row}[pe_planned_time]" readonly="true" span="all" class="planned" dataFormat="@@duration_format"></et2-date-duration>
					</et2-vbox>
					<et2-vbox  class="elementCol2">
						<et2-hbox>
							<et2-link  id="${row}[pm_link]" app="" noLang="1"></et2-link>
							<et2-link  id="${row}[link]" app="" noLang="1"></et2-link>
							<et2-hbox  width="30%" class="elementCat">
								<et2-select-cat  id="${row}[cat_id]" class="et2_ellipsis" readonly="true"></et2-select-cat>
							</et2-hbox>
						</et2-hbox>
						<et2-hbox>
							<et2-date  label="Start" id="${row}[pe_real_start]" readonly="true"></et2-date>
							<et2-date  align="right" label="Planned" id="${row}[pe_planned_start]" readonly="true" class="planned" noLang="1"></et2-date>
						</et2-hbox>
						<et2-hbox>
							<et2-date  label="End" id="${row}[pe_real_end]" readonly="true"></et2-date>
							<et2-date  align="right" label="Planned" id="${row}[pe_planned_end]" readonly="true" class="planned" noLang="1"></et2-date>
						</et2-hbox>
						<et2-hbox  disabled="@no_pe_used_budget_pe_planned_budget">
							<et2-number  label="Budget" id="${row}[pe_used_budget]" readonly="true" max="2"></et2-number>
							<et2-number  align="right" label="Planned" id="${row}[pe_planned_budget]" readonly="true" max="2" class="planned" noLang="1"></et2-number>
						</et2-hbox>
					</et2-vbox>

				</row>
			</rows>
		</grid>
		<et2-styles>
			/* A native &lt;progress&gt; defaults to ~140px, which overflows this column and gets
			   clipped, making every bar look full whatever its value. */
			progress.pe-completion { width: 100%; }
		</et2-styles>
	</et2-template>
	<et2-template  id="projectmanager.elements.list" template="" lang="" group="0" version="1.9.005">
		<et2-description  align="center" id="msg" class="message" noLang="1" disabled="!@msg"></et2-description>
		<et2-nextmatch  id="nm" template="projectmanager.elements.list.rows"></et2-nextmatch>
		<et2-dialog  id="add_existing_popup_dialog" title="Add element" open="false" buttons="" destroyOnClose="false">
			<et2-box  id="add_existing_popup">
				<et2-link-entry  id="link" class="action_popup-content" width="330px"></et2-link-entry>
			</et2-box>
			<et2-button  slot="footer" variant="primary" label="Add" id="add_existing_popup[link_action][add]" image="add" onclick="return app.projectmanager.submit_add_existing(ev, widget);"></et2-button>
			<et2-button  slot="footer" label="Cancel" id="cancel" image="cancelled" noSubmit="true" onclick="widget.closest('et2-dialog').hide(); return false;"></et2-button>
		</et2-dialog>
		<grid width="100%">
			<columns>
				<column/>
			</columns>
			<rows>
				<row>
					<et2-hbox  align="right" disabled="!@nm[selectcols]=/legacy_actions/">
						<et2-button  statustext="Select action" label="Select action" id="legacy_actions" onclick="if (!egw_globalObjectManager.getObjectById('projectmanager.list.rows').executeActionImplementation(this, 'popup')) alert(egw::lang('You need to select some entries first!')); return false;;" noSubmit="true"></et2-button>
						<et2-button  statustext="Check all" label="Check all" id="check_all" onclick="egw_globalObjectManager.getObjectById('projectmanager.elements.list.rows').toggleAllSelected(); return false;" image="arrow_ltr" class="check_all_arrow" required="1"></et2-button>
					</et2-hbox>
				</row>
			</rows>
		</grid>
	</et2-template>
</overlay>
